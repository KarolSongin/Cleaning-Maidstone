# Copy to .env.local for a persistent, synthetic, loopback-only demo.
DEMO_MODE=local
# Demo mode is refused on Vercel. Disable before connecting real accounts.
NEXT_PUBLIC_SITE_URL=https://cleaningmaidstone.co.uk
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Exact publicly reachable HTTPS origin used to validate Twilio signatures.
TWILIO_WEBHOOK_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_STAFF_DESTINATION=
# Recording is OFF unless explicitly enabled with a notice and retention period.
CALL_RECORDING_ENABLED=false
CALL_RECORDING_NOTICE=
CALL_RECORDING_RETENTION_DAYS=30
# Verified public business facts are centralised in src/lib/business.ts.

# Durable AssemblyAI integration; no transcription requests run unless enabled.
TRANSCRIPTION_ENABLED=false
ASSEMBLYAI_API_KEY=
TRANSCRIPTION_WEBHOOK_SECRET=
# Scheduler sends Authorization: Bearer <secret> to transcription, retention and customer-pipeline job routes.
CRON_SECRET=
